# Server
PORT="3000"
NODE_ENV="development"

# Database
MONGODB_URI="mongodb://127.0.0.1:27017/sheetaldhara_chs"

# Signing / cookie secrets. The server refuses to start in production if either
# is missing or still set to a built-in demo value.
JWT_SECRET="replace-with-a-long-random-secret"
COOKIE_SECRET="replace-with-another-long-random-secret"

# Seeded administrator. Required in production; must be at least 8 characters
# and must NOT be "admin123" or any other well-known demo password.
ADMIN_NAME="Ramesh Sharma"
ADMIN_PHONE="9820011223"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Seeded gate watchman. Same production rules as ADMIN_PASSWORD.
WATCHMAN_NAME="Sanjay Yadav"
WATCHMAN_PHONE="9820099001"
WATCHMAN_PASSWORD="replace-with-a-strong-password"

# Comma-separated frontend origins allowed to call the API with credentials,
# e.g. "https://your-app.vercel.app". Leave empty if the API serves the frontend.
CORS_ORIGINS=""
